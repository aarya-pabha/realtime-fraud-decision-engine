# ==============================================================================
# Multi-Stage Production Dockerfile for React Operations Dashboard (SPA + Nginx)
# ==============================================================================

# Stage 1: Build the React TypeScript application
FROM node:20-alpine AS builder
WORKDIR /app

# Install dependencies using clean install
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy application source code and build production assets
COPY frontend/ ./
RUN npm run build

# Stage 2: Production Nginx runtime container
FROM nginx:alpine AS runtime

# Copy compiled SPA dist assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration with /v1/ API reverse proxy
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Lightweight healthcheck verifying Nginx is serving the SPA
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

# Launch Nginx in foreground mode
CMD ["nginx", "-g", "daemon off;"]

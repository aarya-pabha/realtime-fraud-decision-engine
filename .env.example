# ==============================================================================
# Real-Time Transaction Fraud Engine - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kaggle API Credentials (Required for data_pipeline/download_ieee.py)
# ------------------------------------------------------------------------------
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ------------------------------------------------------------------------------
# 2. Online Feature Store & Streaming Broker Endpoints
# ------------------------------------------------------------------------------
# Local development default: localhost:6379 / localhost:19092
# Docker Compose default: redis / redpanda:9092
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECTION_STRING=localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ------------------------------------------------------------------------------
# 3. Serving & Benchmarking Runtime Controls
# ------------------------------------------------------------------------------
# Set to 1 during Locust SLA benchmarking to disable background holdout stream worker
DISABLE_BACKGROUND_STREAM=0

# Option 1: Conditional Adverse-Action TreeSHAP (1 = enabled / 7x lower approval latency, 0 = unconditional)
ENABLE_CONDITIONAL_SHAP=1

# Option 3: Routing mode ('crc' = Conformal Risk Control PAC bound, 'dynamic' = Dynamic Cost Router)
ROUTING_MODE=crc
CRC_TAU_STAR=0.0817

# OpenMP & BLAS single-thread pinning (Eliminates CPU oversubscription in C++ TreeSHAP)
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
NUMEXPR_NUM_THREADS=1
